{
  "name": "kaunch-backend",
  "version": "1.0.0",
  "description": "Kaunch - Office Lunch Management System - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node src/database/createDb.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "db:verify": "node src/database/verify.js",
    "db:patch": "node src/database/patchSchema.js",
    "db:setup": "npm run db:create && npm run migrate && npm run seed",
    "db:reset": "npm run migrate && npm run seed"
  },
  "keywords": ["kaunch", "lunch", "management"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "nodemailer": "^6.9.3",
    "node-cron": "^3.0.2",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
